import numpy as np
import pyvista as pv

# Use pymatgen for structure handling and symmetry analysis.
from pymatgen.io.vasp import Poscar
from pymatgen.core import Structure as PymatgenStructure
from pymatgen.symmetry.analyzer import SpacegroupAnalyzer


# ----------------------------
# Helper: Standard Element Colors
# ----------------------------
def get_element_color(element):
    """
    Returns a standard color (as a string) for a given element symbol.
    Feel free to extend or modify the dictionary below.
    """
    color_dict = {
        "H": "white",
        "He": "cyan",
        "Li": "purple",
        "Be": "darkgreen",
        "B": "salmon",
        "C": "black",
        "N": "blue",
        "O": "red",
        "F": "green",
        "Ne": "orange",
        "Na": "purple",
        "Mg": "green",
        "Al": "gray",
        "Si": "brown",
        "P": "orange",
        "S": "yellow",
        "Cl": "green",
        "Ar": "lightblue",
        "K": "purple",
        "Ca": "green",
        "Fe": "darkorange",
        "Ni": "lightgreen",
        "Cu": "brown",
        "Zn": "grey",
        # Add more elements as needed.
    }
    return color_dict.get(element, "pink")  # default fallback color


# ----------------------------
# 1. Atom, Bond and Spin Classes
# ----------------------------
class Atom:
    """
    Attributes:
        position (numpy.ndarray): [x, y, z] position of the atom.
        species (str): Chemical symbol of the atom.
        atom_type (str): Type of the atom (can be the same as species).
        radius (float): Radius of the sphere representing the atom.
        color (str): Color used to render the atom. If None, a standard color
            is assigned.
        render_info (dict): Additional render information.
    """

    def __init__(self, position, species, atom_type, radius=0.5, color=None, **kwargs):
        """
        Represents an atom for visualization.

        Args:
            position (list or array): [x, y, z] position.
            species (str): Chemical symbol.
            atom_type (str): Atom type (can be the same as species).
            radius (float): Radius for the sphere.
            color (str): Color used to render. If None, a standard color is assigned.
            kwargs: Any additional render information.
        """
        self.position = np.array(position)
        self.species = species
        self.atom_type = atom_type
        self.radius = radius
        self.color = color if color is not None else get_element_color(species)
        self.render_info = kwargs


class Bond:
    """
    Represents a bond rendered as a cylinder.

    Attributes:
        start (numpy.ndarray): The [x, y, z] start position.
        end (numpy.ndarray): The [x, y, z] end position.
        radius (float): The cylinder radius.
        color (str): The cylinder color.
        render_info (dict): Additional render-related options.

        radius (float, optional): Cylinder radius. Defaults to 0.1.
        color (str, optional): Cylinder color. Defaults to 'grey'.
        **kwargs: Additional render-related options.
    """

    def __init__(self, start, end, radius=0.1, color="grey", **kwargs):
        """
        Represents a bond (rendered as a cylinder).

        Args:
            start (list or array): [x, y, z] start position.
            end (list or array): [x, y, z] end position.
            radius (float): Cylinder radius.
            color (str): Cylinder color.
            kwargs: Additional render-related options.
        """
        self.start = np.array(start)
        self.end = np.array(end)
        self.radius = radius
        self.color = color
        self.render_info = kwargs


class Spin:
    def __init__(
        self,
        position,
        direction=(0, 1, 0),
        magnitude=0.0,
        base_radius=0.1,
        tip_radius=0.05,
        color="red",
        **kwargs,
    ):
        """
        Represents a magnetic moment as an arrow.

        Args:
            position (list or array): Position of the atom.
            direction (tuple or array): Direction of the spin.
            magnitude (float): Length scale factor.
            base_radius (float): Radius of the arrow’s shaft.
            tip_radius (float): Radius of the arrow’s tip.
            color (str): Color for the arrow.
            kwargs: Any additional information.
        """
        self.position = np.array(position)
        self.direction = np.array(direction)
        self.magnitude = magnitude
        self.base_radius = base_radius
        self.tip_radius = tip_radius
        self.color = color
        self.render_info = kwargs


# ----------------------------
# 2. Structure Class
# ----------------------------
class Structure:
    """
    Represents a molecular structure with atoms, bonds, and spins.

    Attributes:
        bonds (list): List of Bond objects.
        spins (list): List of Spin objects.
        unit_cell (np.ndarray): Lattice vectors for the unit cell.
        conventional_cell (np.ndarray): Lattice vectors for the conventional cell.

    Methods:
        get_atom_spin_objects():

        get_bond_objects():
            Returns a list of Bond objects. If the bonds list is empty,
            automatically generates bonds based on the distance cutoff.

        compute_conventional_cell(repeat_atoms=True):
            Optionally, repeats the structure (2x2x2) and then selects only
            those atoms within the new conventional cell.
    """

    def __init__(
        self,
        atoms,
        bonds=None,
        spins=None,
        unit_cell=None,
        conventional_cell=None,
        bond_cutoff=1.5,
    ):
        """
        Contains all the structural information.

        Args:
            atoms (list): List of Atom objects.
            bonds (list): List of Bond objects (can be empty; bonds may be generated).
            spins (list): List of Spin objects (optional; default spin will be provided if missing).
            unit_cell (3x3 array-like): Lattice vectors for the unit cell.
            conventional_cell (3x3 array-like): Lattice vectors for the conventional cell.
            bond_cutoff (float): Distance below which atoms are bonded.
        """
        self.atoms = atoms
        self.bonds = bonds if bonds is not None else []
        self.spins = spins if spins is not None else []
        self.unit_cell = np.array(unit_cell) if unit_cell is not None else None
        self.conventional_cell = (
            np.array(conventional_cell) if conventional_cell is not None else None
        )
        self.bond_cutoff = bond_cutoff

    def get_atom_spin_objects(self):
        """
        Returns a list of tuples (Atom, Spin). If a spin is not provided
        for a given atom, a default (zero magnitude) spin is created.
        """
        atom_spin_list = []
        for atom in self.atoms:
            # Look for a spin whose position matches the atom (within tolerance)
            spin = next(
                (s for s in self.spins if np.allclose(s.position, atom.position)), None
            )
            if spin is None:
                spin = Spin(position=atom.position, direction=(0, 0, 0), magnitude=0.0)
            atom_spin_list.append((atom, spin))
        return atom_spin_list

    def get_bond_objects(self):
        """
        Returns a list of Bond objects. If the bonds list is empty, automatically
        generates bonds based on the distance cutoff.
        """
        if not self.bonds:
            n = len(self.atoms)
            for i in range(n):
                for j in range(i + 1, n):
                    pos_i = self.atoms[i].position
                    pos_j = self.atoms[j].position
                    if np.linalg.norm(pos_i - pos_j) <= self.bond_cutoff:
                        self.bonds.append(Bond(start=pos_i, end=pos_j))
        return self.bonds

    def compute_conventional_cell(self, repeat_atoms=True):
        """
        Uses pymatgen's symmetry tools to compute the conventional cell.
        Optionally, repeats the structure (2x2x2) and then selects only those
        atoms within the new conventional cell.
        Updates:
         - self.conventional_cell with the lattice matrix.
         - self.atoms with positions and colors (based on standard convention).

        Args:
            repeat_atoms (bool): Whether to expand the conventional structure to filter
                                 atoms that lie within the cell.
        """
        # Create a pymatgen structure from current data.
        species = [atom.species for atom in self.atoms]
        coords = [atom.position for atom in self.atoms]
        if self.unit_cell is None:
            raise ValueError("Unit cell is not defined in the Structure.")
        pg_struct = PymatgenStructure(self.unit_cell, species, coords)
        # Get the conventional structure.
        sga = SpacegroupAnalyzer(pg_struct)
        conv_struct = sga.get_conventional_standard_structure()
        self.conventional_cell = conv_struct.lattice.matrix

        new_atoms = []
        if repeat_atoms:
            # Repeat structure 2x2x2 and shift to center the cell.
            repeated_struct = conv_struct * (2, 2, 2)
            repeated_struct.translate_sites(
                list(range(len(repeated_struct))), [-1, -1, -1]
            )
            tol = 0.05
            # Filter atoms that are inside the conventional cell (within a tolerance).
            for site in repeated_struct:
                frac = conv_struct.lattice.get_fractional_coords(site.coords)
                if all(-tol <= f <= 1 + tol for f in frac):
                    new_atoms.append(
                        Atom(
                            position=site.coords,
                            species=site.species_string,
                            atom_type=site.species_string,
                            color=get_element_color(site.species_string),
                        )
                    )
        else:
            # Simply update atoms with the sites from the conventional structure.
            for site in conv_struct:
                new_atoms.append(
                    Atom(
                        position=site.coords,
                        species=site.species_string,
                        atom_type=site.species_string,
                        color=get_element_color(site.species_string),
                    )
                )
        self.atoms = new_atoms


# ----------------------------
# 3. Input Reader Class
# ----------------------------
class InputReader:
    """
    A class used to read different types of structure files.

    This class provides static methods to read .xyz, custom, and POSCAR files
    and convert them into Structure objects.

    Methods:
        read_xyz(file_path):
            Reads a simple .xyz file and returns a Structure object.

        read_custom(file_path):
            Stub for reading a custom file format. Implement your own parser.

        read_poscar(file_path):
            Reads a POSCAR file using pymatgen and returns a Structure object.
    """

    @staticmethod
    def read_xyz(file_path):
        """
        Reads a simple .xyz file and returns a Structure.
        Assumes the first line is the number of atoms and the second line is a comment.
        Each subsequent line: species x y z
        """
        atoms = []
        with open(file_path, "r") as f:
            lines = f.readlines()
        num_atoms = int(lines[0].strip())
        # Comment line (unused here)
        _ = lines[1].strip()
        for line in lines[2: 2 + num_atoms]:
            parts = line.split()
            species = parts[0]
            position = [float(x) for x in parts[1:4]]
            atoms.append(
                Atom(
                    position=position,
                    species=species,
                    atom_type=species,
                    color=get_element_color(species),
                )
            )
        return Structure(atoms=atoms)

    @staticmethod
    def read_custom(file_path):
        """
        Stub for reading a custom file format.
        Implement your own file parser here.
        """
        pass

    @staticmethod
    def read_poscar(file_path):
        """
        Reads a POSCAR file using pymatgen and returns a Structure.
        """
        poscar = Poscar.from_file(file_path)
        pg_struct = poscar.structure
        print(dir(pg_struct))
        atoms = []
        for site in pg_struct:
            atoms.append(
                Atom(
                    position=site.coords,
                    species=site.species_string,
                    atom_type=site.species_string,
                    color=get_element_color(site.species_string),
                )
            )
        return Structure(atoms=atoms, unit_cell=pg_struct.lattice.matrix)


# ----------------------------
# 4. Visualizer Class
# ----------------------------
class Visualizer:
    """
    Provides interactive toggles for visualizing different aspects of a
    structure:

    Attributes:
        structure (Structure): The structure to visualize.
        plotter (pv.Plotter): The pyvista plotter instance.
        show_bonds (bool): Toggle for showing bonds.
        show_spins (bool): Toggle for showing spins.
        use_conventional (bool): Toggle for using conventional cell.
        show_extents (bool): Toggle for showing extents.
        periodicity (str or None): Periodicity type ('2d', '3d', or None).
    """

    def __init__(self, structure: Structure):
        """
        Visualizer for a Structure using pyvista.

        Provides interactive toggles:
          - bonds / no bonds
          - unit cell / conventional cell
          - spins / no spins
          - extents / no extents
          - 2d-periodic / non-periodic
          - 3d-periodic / non-periodic
        """
        self.structure = structure
        self.plotter = pv.Plotter()

        # Toggle options (default settings)
        self.show_bonds = True
        self.show_spins = True
        self.use_conventional = False  # False means use unit cell
        self.show_extents = False
        self.periodicity = None  # Options: None, '2d', '3d'

    def toggle_bonds(self):
        self.show_bonds = not self.show_bonds
        self.render()

    def toggle_spins(self):
        self.show_spins = not self.show_spins
        self.render()

    def toggle_cell(self):
        self.use_conventional = not self.use_conventional
        self.render()

    def toggle_extents(self):
        self.show_extents = not self.show_extents
        self.render()

    def toggle_periodicity(self, period="2d"):
        """
        Toggles periodicity.
        period: '2d' or '3d'; if already enabled with this type, then disables periodic images.
        """
        if self.periodicity == period:
            self.periodicity = None
        else:
            self.periodicity = period
        self.render()

    def get_cell(self):
        """
        Returns the lattice cell matrix based on the toggle.
        """
        if self.use_conventional and self.structure.conventional_cell is not None:
            return self.structure.conventional_cell
        elif self.structure.unit_cell is not None:
            return self.structure.unit_cell
        return None

    def expand_structure(self, cell, grid_dims):
        """
        Expands the structure by replicating the cell.

        Args:
            cell: 3x3 lattice matrix.
            grid_dims (tuple): (nx, ny, nz) number of replications.

        Returns:
            A list of new Atom objects corresponding to the periodic images.
        """
        atoms_expanded = []
        for i in range(grid_dims[0]):
            for j in range(grid_dims[1]):
                for k in range(grid_dims[2]):
                    translation = np.dot(cell.T, [i, j, k])
                    for atom in self.structure.atoms:
                        new_pos = atom.position + translation
                        atoms_expanded.append(
                            Atom(
                                position=new_pos,
                                species=atom.species,
                                atom_type=atom.atom_type,
                                radius=atom.radius,
                                color=atom.color,
                            )
                        )
        return atoms_expanded

    def render(self):
        """
        Clears and re-renders the scene with current toggles.
        """
        self.plotter.clear()

        # 1. Render Atoms
        for atom in self.structure.atoms:
            sphere = pv.Sphere(radius=atom.radius, center=atom.position)
            self.plotter.add_mesh(sphere, color=atom.color)

        # 2. Render Bonds (if toggled on)
        if self.show_bonds:
            bonds = self.structure.get_bond_objects()
            for bond in bonds:
                vector = bond.end - bond.start
                length = np.linalg.norm(vector)
                center = (bond.start + bond.end) / 2
                direction = vector / length if length else [0, 0, 1]
                cylinder = pv.Cylinder(
                    center=center,
                    direction=direction,
                    radius=bond.radius,
                    height=length,
                )
                self.plotter.add_mesh(cylinder, color=bond.color)

        # 3. Render Spins (if toggled on)
        if self.show_spins:
            for atom, spin in self.structure.get_atom_spin_objects():
                if spin.magnitude > 0:
                    arrow = pv.Arrow(
                        start=atom.position,
                        direction=spin.direction,
                        tip_length=0.2 * spin.magnitude,
                        tip_radius=spin.tip_radius,
                        shaft_radius=spin.base_radius,
                        scale=spin.magnitude,
                    )
                    self.plotter.add_mesh(arrow, color=spin.color)

        # 4. Render Extents (if toggled on)
        if self.show_extents:
            cell = self.get_cell()
            if cell is not None:
                origin = np.array([0, 0, 0])
                a, b, c = cell[0], cell[1], cell[2]
                corners = np.array([origin, a, b, c, a + b, a + c, b + c, a + b + c])
                xmin, ymin, zmin = corners.min(axis=0)
                xmax, ymax, zmax = corners.max(axis=0)
                box = pv.Box(bounds=(xmin, xmax, ymin, ymax, zmin, zmax))
                self.plotter.add_mesh(box, style="wireframe", color="black")

        # 5. Render Periodic Images (if toggled on)
        if self.periodicity is not None:
            grid_dims = (5, 5, 1) if self.periodicity == "2d" else (4, 4, 4)
            cell = self.get_cell()
            if cell is not None:
                atoms_expanded = self.expand_structure(cell, grid_dims)
                for atom in atoms_expanded:
                    sphere = pv.Sphere(radius=atom.radius, center=atom.position)
                    self.plotter.add_mesh(sphere, color=atom.color, opacity=0.5)

        self.plotter.show(auto_close=False)


# ----------------------------
# 5. Example usage
# ----------------------------
if __name__ == "__main__":
    # Read a POSCAR file using pymatgen
    structure = InputReader.read_poscar(
        "/Users/andersb/Jobb/RS_tools_python/POSCAR"
    )  # <-- update with your file path

    # Optionally, compute the conventional cell using pymatgen's symmetry routines.
    try:
        structure.compute_conventional_cell(repeat_atoms=True)
    except ValueError as e:
        print("Conventional cell computation failed:", e)

    # Debug printing of structure information.
    print("Structure Debug Info:")
    print(f"Number of atoms: {len(structure.atoms)}")
    for atom in structure.atoms:
        print(
            f"Atom: {atom.species}, Position: {atom.position}, Radius: {atom.radius}, Color: {atom.color}"
        )

    print(f"Number of bonds: {len(structure.bonds)}")
    for bond in structure.bonds:
        print(
            f"Bond: Start: {bond.start}, End: {bond.end}, Radius: {bond.radius}, Color: {bond.color}"
        )

    print(f"Number of spins: {len(structure.spins)}")
    for spin in structure.spins:
        print(
            f"Spin: Position: {spin.position}, Direction: {spin.direction}, Magnitude: {spin.magnitude}, Color: {spin.color}"
        )

    if structure.unit_cell is not None:
        print("Unit Cell:")
        print(structure.unit_cell)

    if structure.conventional_cell is not None:
        print("Conventional Cell:")
        print(structure.conventional_cell)

    # Create a Visualizer instance with the structure.
    viz = Visualizer(structure=structure)
    # Uncomment toggles as desired:
    # viz.toggle_bonds()
    # viz.toggle_spins()
    # viz.toggle_cell()
    # viz.toggle_extents()
    # viz.toggle_periodicity('2d')
    # viz.toggle_periodicity('3d')

    viz.render()

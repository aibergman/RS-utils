&calculation
pre_processing = 'bravais'
verbose = T
/
&lattice
ntype = 1
rc = 100
alat =     2.660000
crystal_sym = 'file'
wav = 1.3097108791
! pbc = T
! ndim = 10000
ct(:) =     3.3000
r2 =    10.900000
/
&atoms
database = './'
label(1) = 'Fe'
/
&self
ws_all = .true. ! ''
nstep = 1
conv_thr = 0.5e-9
cold = .true.
/
&energy
fermi = 0.131556
energy_min = -1.0
energy_max = 0.5
channels_ldos = 2500
/
&control
calctype = 'B'
nsp = 2 ! type of calculation, nsp can be 1, 2, 3 or 4
lld = 21
recur = 'block'
/
&mix
beta = 0.2
mixtype = 'broyden'
/

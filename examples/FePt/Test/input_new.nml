&calculation
pre_processing = 'bravais'
verbose = T
/
&lattice
ntype = 2
rc = 100
alat =     3.100000
crystal_sym = 'file'
wav = 1.5248096411
pbc = T
ndim = 10000
ct(1) =     3.9600
ct(2) =     4.2200
r2 =    18.125900
/
&atoms
database = './'
label(1) = 'Fe'
label(2) = 'Pt'
/
&self
ws_all = .true. ! ''
nstep = 5
conv_thr = 0.5e-9
cold = .true.
/
&energy
fermi = -0.069282
energy_min = -1.5
energy_max = 0.5
channels_ldos = 1000
/
&control
calctype = 'B'
nsp = 2 ! type of calculation, nsp can be 1, 2, 3 or 4
lld = 21
recur = 'block'
/
&mix
beta = 0.25
mixtype = 'broyden'
/

setup(
    name="rsutil",
    version="0.1.0",
    author="Your Name",
    author_email="your@email.com",
    description="A Fortran-powered lattice processing tool",
    long_description=open("README.md").read(),
    long_description_content_type="text/markdown",
    url="https://github.com/your-repo/rsutil",
    packages=["rsutil"],
    ext_modules=[CMakeExtension("rsutil._rsutil")],
    cmdclass={"build_ext": CMakeBuild},
    python_requires=">=3.8",
    install_requires=["numpy", "click"],
    entry_points={
        "console_scripts": ["rsutil=rsutil.cli:cli"]
    },
    classifiers=[
        "Programming Language :: Python :: 3",
        "License :: OSI Approved :: MIT License",
        "Operating System :: OS Independent",
    ],
    zip_safe=False,
)


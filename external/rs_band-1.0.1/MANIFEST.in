# Include common top-level files
include README.md
include LICENSE
include requirements.txt
include pyproject.toml
include setup.py

# Include documentation source files (but not build artifacts)
include docs/*.rst
include docs/*.md
include docs/conf.py
recursive-include docs/_static *
recursive-include docs/_templates *

# Include example source files (but not generated outputs)
include examples/*.py
include examples/*.md
include examples/*.nml
include examples/*.dat
recursive-include examples/bccFe/*.nml
recursive-include examples/bccFe/*.dat
recursive-include examples/bccFe/*.md
include examples/bccFe/test_dos_moments.py
include examples/lattice.nml

# Include package data (adjust paths/extensions to your actual data)
recursive-include rs_band *.txt *.dat *.nml *.md
recursive-include rs_band *.cfg *.json
recursive-include rs_band/templates *
recursive-include rs_band/data *

# Exclude generated files and build artifacts
global-exclude *.py[cod]
global-exclude __pycache__/*
global-exclude .DS_Store
exclude docs/Makefile
exclude docs/_build/*
recursive-exclude docs/_build *
exclude examples/bccFe/*.npz
exclude examples/bccFe/*.png
exclude examples/bccFe/*.pdf
recursive-exclude examples/bccFe *.npz
recursive-exclude examples/bccFe *.png
recursive-exclude examples/bccFe *.pdf


[build-system]
requires = ["poetry-core>=1.0.0", "numpy", "cmake", "cibuildwheel", "f90wrap"]
build-backend = "poetry.core.masonry.api"

[tool.poetry]
name = "rsutil"
version = "0.1.0"
description = "A Fortran-powered lattice processing tool"
authors = ["Your Name <your@email.com>"]
license = "MIT"
readme = "README.md"
packages = [{ include = "rsutil" }]

[tool.poetry.dependencies]
python = ">=3.8"
numpy = "*"
click = "*"

[tool.poetry.scripts]
rsutil = "rsutil.cli:cli"

[tool.poetry.build]
script = "build.py"

[tool.cibuildwheel]
build = "cp39-* cp310-* cp311-* cp312-*"
skip = "*-musllinux_*"
archs = "auto"
before-build = "pip install numpy cmake"

